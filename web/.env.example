# Copia este archivo a `.env.local` y ajusta según dónde corras.
# (Next.js solo expone al navegador las variables con prefijo NEXT_PUBLIC_.)

# --- Señalización (el "portero" WebRTC) ------------------------------------
# Local (misma máquina o misma WiFi apuntando a la IP del PC anfitrión):
NEXT_PUBLIC_SIGNAL_URL=ws://localhost:8787
# Desplegado (redes distintas / internet): usar wss:// (WebSocket seguro)
# NEXT_PUBLIC_SIGNAL_URL=wss://bug-signaling.onrender.com

# --- TURN (relay para redes distintas / restrictivas) ----------------------
# Sin TURN, STUN resuelve la mayoría de casos pero falla en algunas redes.
# Opción A) credenciales fijas de tu proveedor (Metered/Cloudflare/coturn):
# NEXT_PUBLIC_TURN_URL=turn:tu-servidor:3478
# NEXT_PUBLIC_TURN_USERNAME=usuario
# NEXT_PUBLIC_TURN_CREDENTIAL=secreto
# Opción B) endpoint que devuelve la lista de ICE servers (p.ej. API de Metered):
# NEXT_PUBLIC_ICE_URL=https://tu-app.metered.live/api/v1/turn/credentials?apiKey=XXXX
